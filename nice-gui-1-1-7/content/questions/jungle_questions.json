al","prompt":"물이 수증기가 되는 변화는?","choices":["증발","냉동","자석"],"answer":"증발","hint":"액체가 기체로 변하는 거야."},{"id":"science-019","subject":"과학","difficulty":"normal","prompt":"나침반은 대체로 무엇을 가리킬까?","choices":["북쪽","물속","달"],"answer":"북쪽","hint":"지구의 자기장과 관련 있어."},{"id":"science-020","subject":"과학","difficulty":"normal","prompt":"초식동물은 주로 무엇을 먹을까?","choices":["식물","돌","플라스틱"],"answer":"식물","hint":"풀이나 잎을 먹는 동물이야."},{"id":"science-021","subject":"과학","difficulty":"hard","prompt":"먹이사슬에서 풀을 먹는 토끼는 어떤 역할일까?","choices":["초식동물","생산자","분해자"],"answer":"초식동물","hint":"식물을 먹는 동물이야."},{"id":"science-022","subject":"과학","difficulty":"hard","prompt":"공기가 따뜻해지면 보통 어떻게 될까?","choices":["가벼워져 올라간다","항상 돌이 된다","빛을 먹는다"],"answer":"가벼워져 올라간다","hint":"따뜻한 공기는 위로 올라가기 쉬워."},{"id":"science-023","subject":"과학","difficulty":"hard","prompt":"물이 얼 때 부피는 보통 어떻게 될까?","choices":["늘어난다","항상 0이 된다","사라진다"],"answer":"늘어난다","hint":"얼음이 물 위에 뜨는 것과 관련 있어."},{"id":"science-024","subject":"과학","difficulty":"hard","prompt":"식물이 햇빛으로 양분을 만드는 과정은?","choices":["광합성","호흡 정지","자전"],"answer":"광합성","hint":"잎에서 햇빛을 이용해 양분을 만들어."},{"id":"science-025","subject":"과학","difficulty":"hard","prompt":"지구의 자전 때문에 생기는 현상은?","choices":["낮과 밤","계절 변화만","달의 모양만"],"answer":"낮과 밤","hint":"지구가 하루에 한 바퀴 도는 것과 관련 있어."}]}
