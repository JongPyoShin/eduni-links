{
  "name": "naver-blog-draft-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Local helper for manually reviewing and saving Naver Blog drafts",
  "scripts": {
    "login": "node src/login.js",
    "save-draft": "node src/save-draft.js",
    "watch": "node src/watch.js",
    "watch:configure": "node src/watch.js --configure",
    "test:watch": "node --test test/*.test.js",
    "autostart:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remove-autostart.ps1"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
