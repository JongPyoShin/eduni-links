# Copy this file outside the repository and pass it with `docker compose --env-file <external-path> ...`.
# Replace every placeholder using the host's approved release and secret configuration.
EDUNI_IMAGE=registry.example/eduni-portal@sha256:<release-digest>
EDUNI_CONTAINER_ENV_FILE=<absolute-host-path-to-container.env>
EDUNI_POSTGRES_PASSWORD=<load-from-host-secret-store>
EDUNI_DATA_VOLUME=<existing-eduni-data-volume>
EDUNI_NETWORK=<existing-eduni-network>
EDUNI_LOOPBACK_PORT=8081EDUNI_PUBLIC_BIND_IP=<existing-host-public-or-vpn-ip>
